rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // ---------- users ----------
    match /users/{uid} {
      allow get: if isSignedIn();
      // lookup by email returns at most one document, so nobody can dump all users
      allow list: if isSignedIn() && request.query.limit <= 1;

      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'createdAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 60
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time;

      allow update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 60;

      allow delete: if false;
    }

    // ---------- projects ----------
    match /projects/{projectId} {
      function validProject(p) {
        return p.keys().hasOnly(['name', 'description', 'ownerId', 'memberIds', 'createdAt', 'updatedAt'])
          && p.keys().hasAll(['name', 'ownerId', 'memberIds', 'createdAt', 'updatedAt'])
          && p.name is string
          && p.name.size() >= 3 && p.name.size() <= 80
          && (!('description' in p)
              || (p.description is string && p.description.size() <= 1000))
          && p.memberIds is list
          && p.updatedAt == request.time;
      }

      allow read: if isSignedIn() && request.auth.uid in resource.data.memberIds;

      allow create: if isSignedIn()
        && validProject(request.resource.data)
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.createdAt == request.time;

      allow update: if isSignedIn()
        && resource.data.ownerId == request.auth.uid
        && validProject(request.resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.auth.uid in request.resource.data.memberIds;

      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      // ---------- tasks ----------
      match /tasks/{taskId} {
        function parentProject() {
          return get(/databases/$(database)/documents/projects/$(projectId)).data;
        }
        function isProjectMember() {
          return isSignedIn() && request.auth.uid in parentProject().memberIds;
        }
        function isProjectOwner() {
          return isSignedIn() && parentProject().ownerId == request.auth.uid;
        }
        function validTask(t) {
          return t.keys().hasOnly(['title', 'description', 'status', 'priority', 'assigneeId', 'dueDate', 'createdBy', 'createdAt', 'updatedAt'])
            && t.keys().hasAll(['title', 'status', 'priority', 'assigneeId', 'dueDate', 'createdBy', 'createdAt', 'updatedAt'])
            && t.title is string
            && t.title.size() >= 3 && t.title.size() <= 120
            && (!('description' in t)
                || (t.description is string && t.description.size() <= 1000))
            && t.status in ['todo', 'in_progress', 'done']
            && t.priority in ['low', 'medium', 'high']
            && (t.assigneeId == null || t.assigneeId in parentProject().memberIds)
            && (t.dueDate == null
                || (t.dueDate is string && t.dueDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')))
            && t.updatedAt == request.time;
        }

        allow read: if isProjectMember();

        allow create: if isProjectMember()
          && validTask(request.resource.data)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time;

        allow update: if isProjectMember()
          && validTask(request.resource.data)
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && (isProjectOwner()
              || resource.data.createdBy == request.auth.uid
              || resource.data.assigneeId == request.auth.uid)
          && (isProjectOwner()
              || resource.data.assigneeId == request.auth.uid
              || request.resource.data.status == resource.data.status);

        allow delete: if isProjectOwner()
          || (isProjectMember() && resource.data.createdBy == request.auth.uid);
      }
    }
  }
}